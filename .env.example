# ====== Trend Hunter — настройки ======
# Скопируйте в .env и заполните. Файл .env НЕ коммитится.

# --- Регион трендов ---
TREND_REGION=RU            # RU, KZ, US, UA, BY ...
TREND_LANGUAGE=ru
# Какие источники включены (через запятую)
SOURCES=google_trends,google_news,youtube,hackernews,reddit,habr,lenta,tass,instagram,custom_rss
# Свои RSS-ленты через запятую (необязательно)
EXTRA_RSS_FEEDS=

# --- YouTube Data API v3 (тренды YouTube + поиск видео по теме) ---
# https://console.cloud.google.com → APIs → YouTube Data API v3 → Credentials → API key
YOUTUBE_API_KEY=

# --- Instagram (необязательно): официального API трендов нет, используем Apify ---
# https://console.apify.com/account/integrations
APIFY_TOKEN=
INSTAGRAM_HASHTAGS=новости,тренды

# --- ИИ-сценарий: любой OpenAI-совместимый API ---
# OpenAI:   LLM_BASE_URL=https://api.openai.com/v1   LLM_MODEL=gpt-4o-mini
# xAI Grok: LLM_BASE_URL=https://api.x.ai/v1         LLM_MODEL=grok-3-mini
# DeepSeek: LLM_BASE_URL=https://api.deepseek.com/v1 LLM_MODEL=deepseek-chat
# Без ключа сценарий собирается из найденных текстов (короче и проще).
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# --- Озвучка (мужской голос) ---
TTS_PROVIDER=edge          # edge (бесплатно) | piper (офлайн, бесплатно) | openai | elevenlabs
EDGE_TTS_VOICE=ru-RU-DmitryNeural
EDGE_TTS_RATE=+0%
OPENAI_API_KEY=            # для TTS_PROVIDER=openai (голос onyx)
OPENAI_TTS_VOICE=onyx
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB

# --- Видео ---
VIDEO_WIDTH=1280
VIDEO_HEIGHT=720
WORDS_PER_MINUTE=120

# --- Telegram ---
# Токен бота от @BotFather. Бота нужно добавить в канал АДМИНИСТРАТОРОМ с правом публикации.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL=@koleso_uspeha     # или https://t.me/имя, или числовой id -100...
# Обычный Bot API принимает файлы до 50 МБ. С локальным Bot API сервером — до 2000 МБ:
TELEGRAM_API_URL=https://api.telegram.org
TELEGRAM_MAX_MB=49

# --- Веб-интерфейс ---
ADMIN_PASSWORD=            # если задан — генерация и публикация только с паролем
AUTO_POST_EVERY_HOURS=0    # >0 — сервер сам публикует самый горячий тренд каждые N часов
